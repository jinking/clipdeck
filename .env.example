SCI_ACQUISITION_DATA=./data
SCI_MAX_UPLOAD_BYTES=1073741824
# 仅当本机 Clash/Surge 使用 198.18.0.0/15 Fake-IP DNS 时开启。
SCI_ALLOW_PROXY_FAKE_IP=false

# MinerU 精准解析 API。请只写入本地 .env 或进程环境，切勿提交真实 Token。
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_RESULT_HOSTS=cdn-mineru.openxlab.org.cn,mineru.net
MINERU_TIMEOUT_SECONDS=180
MINERU_MAX_RESULT_ZIP_BYTES=524288000
MINERU_REQUEST_RETRIES=3
MINERU_UPLOAD_RETRIES=2
SCI_MINERU_POLL_INITIAL_SECONDS=2
SCI_MINERU_POLL_MAX_SECONDS=30
SCI_MINERU_TASK_TIMEOUT_SECONDS=1800

# 可选网页 LLM 正文提取。只有显式开启外发授权后才会发送网页正文；
# 不会读取或复用 OPENAI_API_KEY。
SCI_LLM_EXTERNAL_PROCESSING_ALLOWED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-Text-01
